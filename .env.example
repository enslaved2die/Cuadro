# Cuadro Backend Configuration
PORT=8080
FRAME_TOKEN=memories-frame-secure-token-12345
# ADMIN_PASSWORD=  # Leave unset to auto-generate a secure password (printed to logs on first startup)

# Set to 1 only if this app sits behind a trusted reverse proxy (e.g. Cloudflare
# Tunnel, Nginx) that overwrites X-Forwarded-For/CF-Connecting-IP itself. Leave at 0
# for a direct/bare deployment, otherwise clients can spoof their IP via these
# headers and bypass the login rate limiter.
TRUST_PROXY=0

# Refresh & Watchdog Timers (in seconds & hours)
DEFAULT_SLEEP_SECONDS=14400
WATCHDOG_HOURS=24
IDLE_SHUFFLE_HOURS=24

# Immich Integration
IMMICH_HOST=https://immich.yourdomain.com
IMMICH_API_KEY=your_immich_api_key_here
IMMICH_ALBUM_ID=your_immich_album_uuid_here

# Google Photos Integration
GOOGLE_PHOTOS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_PHOTOS_CLIENT_SECRET=your_client_secret
GOOGLE_PHOTOS_REFRESH_TOKEN=your_refresh_token
GOOGLE_PHOTOS_ALBUM_ID=your_google_photos_album_id

# Apple iCloud Shared Album Integration (Token from public shared stream URL)
ICLOUD_SHARED_ALBUM_TOKEN=B0q5a0vGz7zJv8
